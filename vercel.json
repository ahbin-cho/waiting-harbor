{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/l/:id",
      "destination": "/api/lantern?id=:id"
    },
    {
      "source": "/discharge",
      "destination": "/discharge/index.html"
    },
    {
      "source": "/rainbow",
      "destination": "/rainbow/index.html"
    },
    {
      "source": "/memorial",
      "destination": "/memorial/index.html"
    },
    {
      "source": "/ldr",
      "destination": "/ldr/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "17 3 * * *"
    }
  ]
}
