# Project Settings > Data API 의 Project URL (끝의 /rest/v1/ 은 빼요)
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API Keys 의 publishable key (sb_publishable_...) 또는 예전 anon key
VITE_SUPABASE_ANON_KEY=your-anon-key
# (선택) 카카오 개발자 콘솔 > 앱 키 > JavaScript 키. 사이트 주소를 Web 플랫폼에 등록해야 해요.
VITE_KAKAO_JS_KEY=
